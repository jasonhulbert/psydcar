{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "analytics": false
  },
  "projects": {
    "psydcar": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.json",
            "outputPath": {
              "base": "../src/psydcar/app_assets",
              "browser": ""
            },
            "outputHashing": "all",
            "optimization": {
              "scripts": true,
              "styles": {
                "inlineCritical": false
              }
            },
            "styles": [
              "src/styles.css"
            ]
          }
        }
      }
    }
  }
}
